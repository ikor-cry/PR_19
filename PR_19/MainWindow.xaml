<Window x:Class="PR_19.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Регистрация" Height="400" Width="400">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Text="Имя:" VerticalAlignment="Center" Margin="0,5,10,5"/>
        <TextBox Grid.Row="0" Grid.Column="1" x:Name="NameInput" Margin="0,5"/>

        <TextBlock Grid.Row="1" Grid.Column="0" Text="Email:" VerticalAlignment="Center" Margin="0,5,10,5"/>
        <TextBox Grid.Row="1" Grid.Column="1" x:Name="EmailInput" Margin="0,5"/>

        <TextBlock Grid.Row="2" Grid.Column="0" Text="Пароль:" VerticalAlignment="Center" Margin="0,5,10,5"/>
        <PasswordBox Grid.Row="2" Grid.Column="1" x:Name="PasswordInput" Margin="0,5"/>

        <TextBlock Grid.Row="3" Grid.Column="0" Text="Роль:" VerticalAlignment="Center" Margin="0,5,10,5"/>
        <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Margin="0,5">
            <RadioButton x:Name="StudentRadio" Content="Студент" GroupName="Role" IsChecked="True" Margin="0,0,10,0"/>
            <RadioButton x:Name="TeacherRadio" Content="Преподаватель" GroupName="Role"/>
        </StackPanel>

        <CheckBox Grid.Row="4" Grid.Column="1" x:Name="AgreeCheckBox" Content="Согласен с правилами" Margin="0,10,0,5"/>

        <Button Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="2" Content="Зарегистрироваться" Click="RegisterButton_Click" Height="30"/>
    </Grid>
</Window>